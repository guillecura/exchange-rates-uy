{
  "name": "exchange-rates-uy",
  "version": "1.0.0",
  "description": "Uruguay's exchange rates, self-hosted: the official one (Banco Central del Uruguay) and the market's, any pair, customizable pairs and schedule, an API, a public page and a panel. Any backend: SQLite, Postgres (Supabase, Neon, Vercel, RDS), Cloudflare D1; Node, Workers, Lambda, Vercel, Deno, Bun.",
  "keywords": [
    "exchange-rates",
    "currency",
    "fx",
    "bcu",
    "uruguay",
    "cotizaciones",
    "self-hosted",
    "sqlite",
    "postgres",
    "supabase",
    "cloudflare-workers",
    "d1",
    "aws-lambda",
    "vercel"
  ],
  "license": "MIT",
  "author": "Guille Cura",
  "homepage": "https://fx.whitebear.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guillecura/exchange-rates-uy.git"
  },
  "bugs": "https://github.com/guillecura/exchange-rates-uy/issues",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "exchange-rates-uy": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./money": {
      "types": "./dist/money.d.ts",
      "default": "./dist/money.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./sqlite": {
      "types": "./dist/sqlite.d.ts",
      "default": "./dist/sqlite.js"
    },
    "./d1": {
      "types": "./dist/d1.d.ts",
      "default": "./dist/d1.js"
    },
    "./postgres": {
      "types": "./dist/postgres.d.ts",
      "default": "./dist/postgres.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "default": "./dist/worker.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./lambda": {
      "types": "./dist/lambda.d.ts",
      "default": "./dist/lambda.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && chmod +x dist/cli.js",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "start": "node --disable-warning=ExperimentalWarning src/cli.ts serve",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3",
    "@electric-sql/pglite": "0.3.14"
  }
}
